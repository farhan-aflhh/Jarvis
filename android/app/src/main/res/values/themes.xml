<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Jarvis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/gold_dim</item>
    </style>

    <style name="Outline">
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/outline</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:padding">12dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
