<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.42"
            android:text="JARVIS"
            android:textColor="@color/gold"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="Offline"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/line" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:background="@drawable/ring"
            android:fontFamily="serif"
            android:letterSpacing="0.3"
            android:stateListAnimator="@null"
            android:text="ACTIVATE"
            android:textColor="@color/gold"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/speak"
                style="@style/Outline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="SPEAK NOW" />

            <Button
                android:id="@+id/reset"
                style="@style/Outline"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="CLEAR MEMORY" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:hint="Or type to Jarvis"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences" />

            <Button
                android:id="@+id/send"
                style="@style/Outline"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="SEND" />
        </LinearLayout>

        <TextView style="@style/Label" android:text="YOU" />

        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="#C8C2B5"
            android:textSize="14sp" />

        <TextView style="@style/Label" android:text="JARVIS" />

        <TextView
            android:id="@+id/reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.2"
            android:text="Good to see you, sir."
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/reportLabel"
            style="@style/Label"
            android:text="LATEST DOSSIER"
            android:visibility="gone" />

        <TextView
            android:id="@+id/report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/field"
            android:lineSpacingMultiplier="1.25"
            android:padding="14dp"
            android:textColor="#D9D3C6"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settingsToggle"
            style="@style/Label"
            android:layout_marginTop="36dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="SETTINGS  ▾" />

        <LinearLayout
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/accessKey"
                style="@style/Field"
                android:hint="Picovoice AccessKey (for the wake word)"
                android:inputType="textNoSuggestions" />

            <EditText
                android:id="@+id/brainCode"
                style="@style/Field"
                android:hint="Brain code (shown in Termux)"
                android:inputType="number" />

            <EditText
                android:id="@+id/icsUrl"
                style="@style/Field"
                android:hint="Google Calendar secret iCal link"
                android:inputType="textUri" />

            <Button
                android:id="@+id/save"
                style="@style/Outline"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="SAVE" />

            <Button
                android:id="@+id/battery"
                style="@style/Outline"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="LET JARVIS RUN IN BACKGROUND" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
