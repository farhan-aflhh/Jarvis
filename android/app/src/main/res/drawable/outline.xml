<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#22C9A45C" /><stroke android:width="1dp" android:color="@color/gold" /><corners android:radius="4dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><stroke android:width="1dp" android:color="@color/gold_dim" /><corners android:radius="4dp" /></shape>
    </item>
</selector>
